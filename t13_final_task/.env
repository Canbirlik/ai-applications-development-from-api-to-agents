# Native Docker Engine (e.g. on Linux/WSL2 without Docker Desktop) doesn't resolve
# host.docker.internal by default, which is docker-compose.yml's default value for
# USERS_MANAGEMENT_SERVICE_URL. Use the compose service name instead — it's reachable
# on the shared compose network at the container's internal port (8000).
USERS_MANAGEMENT_SERVICE_URL=http://userservice:8000
